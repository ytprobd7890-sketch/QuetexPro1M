{
  "name": "Quetex Pro 1M — Trading Analysis",
  "short_name": "Quetex 1M",
  "description": "1-minute confluence analysis, next-candle engine and chart-image reader. Research tool, not advice.",
  "id": ".",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#05080c",
  "theme_color": "#05080c",
  "categories": [
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "chart",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif",
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "1M Edge",
      "url": "./?tab=edge"
    },
    {
      "name": "Backtest Lab",
      "url": "./?tab=backtest"
    }
  ]
}
